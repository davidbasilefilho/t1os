#!/usr/bin/python3
"""Credential-free candidate check: start the actual staged Pi extension graph in RPC mode."""
import importlib.util
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import tempfile
import time

REQUIRED = {"Agent", "SubagentWorkflow", "todo", "ask_user_question", "process", "ffgrep", "fffind", "codemode"}
COMMANDS = {"approve", "skill:instruction-writing", "agents", "acp", "todos", "ps", "fff-health", "kimi-settings"}


def result(records):
    """Require a real RPC response and the extension tool registry, without submitting a turn."""
    responses = {v["id"]: v for v in records if v.get("type") == "response" and "id" in v}
    for name in ("get_state", "get_commands"):
        entry = responses.get(name, {})
        if entry.get("command") != name or entry.get("success") is not True:
            raise ValueError(f"Pi RPC {name} did not succeed")
    names = {c.get("name") for c in responses["get_commands"].get("data", {}).get("commands", [])}
    if missing := COMMANDS - names:
        raise ValueError("required Pi extension commands missing: " + ", ".join(sorted(missing)))


def check(release):
    modules = release / "agent-host/pi-deps/node_modules"
    binpath = release / "agent-host/bin"
    spec = importlib.util.spec_from_file_location("registration", release / "runtime/agent/stage.py")
    register = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(register)
    with tempfile.TemporaryDirectory(prefix="t1os-rpc-") as tmp:
        home = Path(tmp).resolve()
        os.umask(0o077)
        register.stage(release / "runtime/agent/holyagent-0.3.3.tgz", home, modules)
        env = {"PATH": f"{binpath}:/usr/bin:/bin", "HOME": str(home), "CI": "1", "TERM": "dumb",
               "PI_OFFLINE": "1", "PI_SKIP_VERSION_CHECK": "1", "T3_PI_RUNTIME_MODE": "approval-required"}
        for binary, version in [(binpath / "node", "v24.22.3"), (binpath / "bun", "1.4.4"),
                                (binpath / "pi", "1.5.0"), (release / "agent-host/t3-release/t3", "t3 v0.1.10"),
                                (home / ".local/share/t1os/agent/holyagent-0.3.3/scripts/holyagent", "0.3.3")]:
            output = subprocess.check_output([binary, "--version"], cwd=home, env=env,
                                             stdin=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=15)
            if output.decode().strip() != version:
                raise ValueError(f"{binary.name}: expected {version}")
        # The probe only reports tool names; it does not invoke a tool, select a model or issue a prompt.
        work = home / "worktree"
        work.mkdir()
        (work / "fixture.txt").write_text("private readiness marker")
        # Loading an extension alone does not prove its platform native library is present.
        subprocess.run([binpath / "node", "--input-type=module", "-e", """
          const {FileFinder} = await import(process.argv[1]);
          const result = FileFinder.create({basePath: process.cwd()});
          if (!result.ok) process.exit(2);
          try {
            await result.value.waitForScan(5000);
            const found = result.value.fileSearch("fixture.txt");
            if (!found.ok || !found.value.items.some(x => x.relativePath === "fixture.txt")) process.exitCode = 3;
          } finally { result.value.destroy(); }
        """, (modules / "@ff-labs/fff-node/dist/index.js").as_uri()], cwd=work, env=env,
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            check=True, timeout=12)
        probe = home / "probe.mjs"
        probe.write_text('import {writeFileSync} from "node:fs";\n'
                         'export default pi => pi.on("session_start", () => {\n'
                         'writeFileSync(process.env.HOME + "/tools.json", JSON.stringify('
                         'pi.getAllTools().map(t => t.name)));\n});\n')
        with (home / "rpc.out").open("wb") as log, (home / "rpc.err").open("wb") as err:
            command = [binpath / "pi", "--mode", "rpc", "--no-session", "-e", probe]
            with subprocess.Popen(command, stdin=subprocess.PIPE, stdout=log, stderr=err, cwd=work,
                                  env=env, start_new_session=True) as process:
                try:
                    for name in ("get_state", "get_commands"):
                        process.stdin.write((json.dumps({"id": name, "type": name}) + "\n").encode())
                    process.stdin.flush()
                    deadline = time.monotonic() + 40
                    while time.monotonic() < deadline:
                        if process.poll() is not None:
                            raise ValueError("Pi exited before RPC readiness")
                        if (home / "rpc.out").stat().st_size > 2097152 or (home / "rpc.err").stat().st_size > 1048576:
                            raise ValueError("Pi readiness output exceeded limit")
                        lines = (home / "rpc.out").read_bytes().split(b"\n")[:-1]
                        records = [json.loads(line) for line in lines if line.startswith(b"{")]
                        if any(v.get("id") == "get_commands" for v in records):
                            result(records)
                            break
                        time.sleep(0.1)
                    else:
                        raise ValueError("Pi RPC readiness timed out")
                finally:
                    try:
                        os.killpg(process.pid, signal.SIGKILL)
                    except ProcessLookupError:
                        pass
        tools = set(json.loads((home / "tools.json").read_text()))
        if missing := REQUIRED - tools:
            raise ValueError("required Pi tools missing: " + ", ".join(sorted(missing)))
        print("Pi RPC: get_state, get_commands and headless tools passed")


def main():
    if len(sys.argv) != 2 or not Path(sys.argv[1]).is_absolute() or os.geteuid() == 0:
        raise ValueError("usage (as a non-root operator): check-ready /absolute/candidate/release")
    release = Path(sys.argv[1]).resolve(strict=True)
    parent = os.environ.get("T1OS_READY_NET")
    if parent is None:
        subprocess.run(["/usr/bin/unshare", "--user", "--map-current-user", "--net", "--",
                        sys.executable, "-BI", __file__, release], check=True, timeout=140,
                       stdin=subprocess.DEVNULL,
                       env={"PATH": "/usr/bin:/bin", "T1OS_READY_NET": os.readlink("/proc/self/ns/net")})
        return
    ids = Path("/proc/self/uid_map").read_text().split()
    interfaces = {line.split(":")[0].strip() for line in Path("/proc/net/dev").read_text().splitlines()[2:]}
    if (parent == os.readlink("/proc/self/ns/net") or interfaces != {"lo"}
            or ids != [str(os.geteuid()), str(os.geteuid()), "1"]):
        raise ValueError("isolated user and network namespaces required")
    check(release)


if __name__ == "__main__":
    try:
        main()
    except (ValueError, OSError, subprocess.SubprocessError) as exc:
        raise SystemExit(f"t1os readiness: {exc}") from exc
