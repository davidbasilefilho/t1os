#!/bin/bash
set -euo pipefail
export PATH=/usr/bin:/bin
release=$(dirname "$(dirname "$(readlink -e "$0")")")
case "$#:${1-}" in
  0:) exec "$release/bin/t1os-guest-platform" first-boot ;;
  1:--prepare) exec "$release/bin/t1os-guest-platform" first-boot --prepare "$release" ;;
  *) echo 'usage: first-boot [--prepare]' >&2; exit 2 ;;
esac
