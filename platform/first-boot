#!/usr/bin/env bash
set -euo pipefail
umask 022
export PATH=/usr/bin:/bin
[[ $EUID == 0 ]] || { echo 'first boot requires root' >&2; exit 2; }
exec 9>/run/t1os-provision.lock
flock -x 9
state=/var/lib/t1os
base=/opt/t1os
case $#:${1-} in
  0:) candidate=0
      # Invalidate earlier same-boot success before trying to apply the unit again.
      [[ ! -e /run/t1os-first-boot.ok ]] || unlink /run/t1os-first-boot.ok
      release=$(readlink -e "$base/current")
      ;;
  1:--prepare) candidate=1; release=$(dirname "$(dirname "$(readlink -e "${BASH_SOURCE[0]}")")") ;;
  *) echo 'usage: first-boot [--prepare]' >&2; exit 2 ;;
esac
[[ ${release##*/} =~ ^[0-9a-f]{64}$ ]] || { echo 'invalid release digest' >&2; exit 1; }
[[ ${release%/*} == "$base/releases" ]] || { echo 'invalid active release' >&2; exit 1; }
[[ $(stat -c '%u:%a' "$release") == '0:755' ]] || { echo 'invalid release ownership' >&2; exit 1; }

# The developer/admin account is not the long-running operator account.
if ! id t1os >/dev/null 2>&1; then
  useradd --create-home --user-group --shell /bin/bash t1os
fi
uid=$(id -u t1os)
[[ $uid -ge 1000 && $(id -Gn t1os) == t1os ]] ||
  { echo 'existing t1os account must be an unprivileged, dedicated operator' >&2; exit 1; }
[[ $(passwd -S t1os | awk '{print $2}') == L ]] ||
  { echo 'existing t1os operator password must remain locked' >&2; exit 1; }
[[ $(getent passwd t1os | cut -d: -f6) == /home/t1os && ! -L /home/t1os &&
   $(stat -c '%u' /home/t1os) == "$uid" ]] || { echo 'invalid t1os operator home' >&2; exit 1; }
install -d -m 0700 "$state"
"$release/runtime/install.sh" /
systemctl daemon-reload
# Never enable the stock broad listeners. The optional tailscale-bound socket stays dormant.
for unit in sshd.service sshd.socket; do
  if [[ $(systemctl show "$unit" --property=LoadState --value) == loaded ]]; then
    systemctl disable --now "$unit"
  fi
done
# Display manager may be active during a console install. This changes the next boot, not this session.
systemctl set-default multi-user.target
if [[ $(systemctl show sddm.service --property=LoadState --value) == loaded ]]; then
  systemctl disable sddm.service
fi
managed_cli="$base/current/bin/t1os"
public_cli=/usr/local/bin/t1os
existing_cli=$(readlink "$public_cli" 2>/dev/null || :)
if [[ -x $release/bin/t1os ]]; then
  if [[ ( -e $public_cli || -L $public_cli ) && $existing_cli != "$managed_cli" ]]; then
    echo "refusing to overwrite existing $public_cli" >&2
    exit 1
  fi
  install -d -m 0755 /usr/local/bin
  ln -sfnT "$managed_cli" "$public_cli"
elif [[ $existing_cli == "$managed_cli" ]]; then
  unlink "$public_cli"
fi
if [[ -f $release/runtime/agent/holyagent-0.3.3.tgz || -d $release/agent-host ]]; then
  [[ -d $release/agent-host && -f $release/runtime/agent/holyagent-0.3.3.tgz ]] ||
    { echo 'full agent profile requires both the locked agent tools and HolyAgent package' >&2; exit 1; }
  runuser -u t1os -- env -i HOME=/home/t1os USER=t1os LOGNAME=t1os PATH=/usr/bin:/bin \
    "$release/runtime/agent-host/check-ready" "$release"
  runuser -u t1os -- env -i HOME=/home/t1os USER=t1os LOGNAME=t1os PATH=/usr/bin:/bin \
    "$release/runtime/agent/stage.py" "$release/runtime/agent/holyagent-0.3.3.tgz"
fi
# Promotion is the provisioner's job. Never advertise an unverified candidate as applied.
if (( candidate )); then
  echo "t1os candidate prepared: ${release##*/}"
  exit 0
fi
tmp=$(mktemp "$state/.applied.XXXXXX")
printf '%s\n' "${release##*/}" >"$tmp"
mv -Tf "$tmp" "$state/applied"
read -r boot_id < /proc/sys/kernel/random/boot_id
[[ $boot_id =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] ||
  { echo 'invalid Linux boot ID' >&2; exit 1; }
proof=$(mktemp /run/.t1os-first-boot.XXXXXX)
printf '%s %s\n' "${release##*/}" "$boot_id" >"$proof"
echo "t1os first boot applied: ${release##*/}"
mv -Tf "$proof" /run/t1os-first-boot.ok
