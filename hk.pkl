amends "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Config.pkl"

steps {
    ["format"] {
        check = "bun run fmt:check"
    }

    ["lint"] {
        check = "bun run lint"
    }
}

hooks {
    ["pre-push"] {
        steps {
            ["types"] {
                check = "bun run check"
            }

            ["test"] {
                check = "bun test"
            }
        }
    }
}
